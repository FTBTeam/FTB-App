{
  "productName": "FTB Electron App",
  "name": "ftb-app",
  "version": "1.30.2",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "email": "admin@feed-the-beast.com",
  "author": {
    "name": "Feed The Beast",
    "email": "admin@feed-the-beast.com",
    "url": "https://feed-the-beast.com"
  },
  "description": "FTB Desktop App for downloading and managing Modpacks",
  "scripts": {
    "dev": "cross-env NODE_ENV=development vite",
    "dev:ads": "cross-env SHOW_ADS=true npm run dev",
    "build": "cross-env NODE_ENV=production vue-tsc && cross-env NODE_ENV=production vite build && ow-electron-builder --config ./electron-builder.yml",
    "build:bin:all:64": "npm run build -- -wl --x64",
    "build:bin:all:arm": "npm run build -- -l --arm64",
    "build:bin:mac:64": "npm run build -- -m --x64",
    "build:bin:mac:arm": "npm run build -- -m --arm64",
    "gen:license": "license-checker --excludePrivatePackages --json --production > licenses.json",
    "overwolf:dev": "node tooling/overwolf/preinit.js && cross-env NODE_ENV=development vite build --mode overwolf",
    "overwolf:build": "cross-env NODE_ENV=production vue-tsc && cross-env NODE_ENV=production vite build --mode overwolf"
  },
  "engines": {
    "node": "^24"
  },
  "dependencies": {
    "@floating-ui/vue": "^1.1.11",
    "@types/object-inspect": "^1.13.0",
    "adm-zip": "0.6.0",
    "balloon-css": "^1.2.0",
    "dayjs": "^1.11.21",
    "electron-updater": "^6.3.9",
    "marked": "^15.0.12",
    "mitt": "^3.0.1",
    "object-inspect": "^1.13.4",
    "openid-client": "^6.4.2",
    "pinia": "^3.0.4",
    "semver": "^7.8.5",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4",
    "vue-virtual-scroller": "2.0.1",
    "wysiwyg.css": "^0.0.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@overwolf/ow-cli": "0.1.8",
    "@overwolf/ow-electron": "^39.8.13",
    "@overwolf/ow-electron-builder": "^26.9.2",
    "@overwolf/types": "^3.24.11",
    "@tailwindcss/vite": "^4.2.2",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.2.0",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-vue": "^5.0.4",
    "archiver": "^5.3.2",
    "cross-env": "^10.1.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "electron-log": "^5.4.4",
    "glob": "^13.0.6",
    "license-checker": "25.0.1",
    "sass": "^1.102.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.12",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "yauzl": "3.3.1"
  }
}
